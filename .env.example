# Copy to .env and fill in. In production every value is required and the app
# refuses to start without it. Never commit the real .env.

# NODE_ENV is set by the npm scripts: `next start` runs as production.

# The one SQLite database file (keep it on an OS-encrypted volume in production).
DATABASE_PATH=data/dev.sqlite

# Where backups go: the nightly opd-<date>.sqlite (02:00 Manila, newest 30
# kept) and db:migrate's pre-migrate-<timestamp>.sqlite (newest 10 kept).
# In production, a separate OS-encrypted disk (see docs/operations.md).
BACKUP_DIR=data/backups

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The URL staff open the app at (behind the TLS reverse proxy in production).
BETTER_AUTH_URL=http://localhost:3000

# Manual testing only, ignored in production: shorten the 15-minute idle
# session (seconds, 30-900) and the 60-second warning lead time.
# OPD_SESSION_SECONDS=90
# OPD_WARN_SECONDS=30
